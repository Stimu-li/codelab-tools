# Build artifacts
dist/
build/
tmp/

# Ignore everything under sample-codelabs by default
sample-codelabs/*

# Allow markdown files at root of sample-codelabs
!sample-codelabs/*.md

# Allow shared images
!sample-codelabs/img/
!sample-codelabs/img/**

# Environment variables
.env
.env.local
.env.*.local

# Certificates and keys
*.pem
*.key
*.cert

# Archives
*.zip
*.tar.gz
*.rar

# Generated documentation
docs/_build/
site/
